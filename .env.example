# Frontend (Vite) — leave empty to run in local/offline mode
VITE_CONVEX_URL=

# Server-side keys — set these with `npx convex env set KEY value` (dev) / `--prod`,
# and export them in your shell for the scripts/ pre-generation scripts.
WORLDLABS_API_KEY=
TRIPO_API_KEY=
MINT_API_KEY=
ANTHROPIC_API_KEY=
